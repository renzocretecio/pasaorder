{
  "name": "pasaorder",
  "version": "1.0.0",
  "description": "QR menu ordering and order management for small businesses",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --parallel --filter \"./packages/**\" --filter api --filter web dev",
    "dev:api": "pnpm build:packages && pnpm --filter api dev",
    "dev:web": "pnpm build:packages && pnpm --filter web dev",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm -r build",
    "build:api": "pnpm --filter api... build",
    "build:web": "pnpm --filter web... build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm --filter web lint",
    "test": "pnpm build:packages && pnpm --filter api test",
    "test:manual-orders": "pnpm --filter @pasaorder/validation build && node scripts/manual-order-queue.test.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @pasaorder/db generate",
    "db:migrate": "pnpm --filter @pasaorder/db migrate",
    "db:studio": "pnpm --filter @pasaorder/db studio",
    "env:setup": "node scripts/setup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth:e2e": "pnpm build && node scripts/auth-smoke.mjs",
    "test:catalog:e2e": "pnpm build && node scripts/catalog-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "prettier": "^3.9.9",
    "typescript": "^6.0.2",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  }
}
