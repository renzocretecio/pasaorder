# Next.js server -> Express API, including the /api prefix.
# Local development:
API_URL=http://localhost:4000/api

# Browser redirect target for OAuth. In production, use the public API URL,
# even when API_URL above uses a private/internal address.
API_PUBLIC_URL=http://localhost:4000/api

# Public web origin used by the OAuth callback redirects.
# Local development:
WEB_ORIGIN=http://localhost:3000

# Browser -> API origin for Socket.IO, without /api. Leave unset in production
# when the web server reverse-proxies /socket.io/ to the API; the app uses its
# current origin automatically. Local development:
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Production examples (replace with your deployed API URL):
# API_URL=https://api.example.com/api
# API_PUBLIC_URL=https://api.example.com/api
# WEB_ORIGIN=https://your-web-domain.com
# NEXT_PUBLIC_SOCKET_URL=https://api.example.com

# Keep secrets (Google, R2, and database credentials) in apps/api/.env.
# Do not put secrets in NEXT_PUBLIC_* variables.
