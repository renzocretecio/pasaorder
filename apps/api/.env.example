NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pasaorder:pasaorder@localhost:5432/pasaorder
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
# Optional Google sign-in. Register this exact callback URL in Google Cloud Console.
# Local callback: http://localhost:4000/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Optional order extraction for reviewed chat drafts (Google Gemini API)
# GEMINI_API_KEY=your-gemini-api-key
# Optional local ThinkLess classifier. Set both values and use the same key
# in apps/inference/.env. Run pnpm dev:inference in a second terminal.
# INFERENCE_URL=http://127.0.0.1:8001
# INFERENCE_API_KEY=generate-a-random-secret-at-least-32-characters
# Optional Facebook Messenger Page connection (Meta Login for Business).
# Set the callback URL in Meta to https://your-api-domain/api/meta/oauth/callback
# and the webhook callback to https://your-api-domain/api/meta/webhook.
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
# META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
# (META_VERIFY_TOKEN is also accepted for older env files.)
# META_TOKEN_ENCRYPTION_KEY=64-character-hex-key (openssl rand -hex 32)
# META_REDIRECT_URI=https://your-api-domain/api/meta/oauth/callback
# META_GRAPH_API_VERSION=v26.0
# Image storage (Cloudflare R2; required for uploads and existing image URLs).
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_BUCKET_NAME=your-bucket
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# IMAGE_PREFIX=staging (optional; defaults to NODE_ENV)
