NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pasaorder:pasaorder@localhost:5432/pasaorder
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
# Optional Google sign-in. Register this exact callback URL in Google Cloud Console.
# Local callback: http://localhost:4000/api/auth/google/callback
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Image storage (Cloudflare R2; required for uploads and existing image URLs).
# R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# R2_BUCKET_NAME=your-bucket
# Optional separate private bucket for payment proofs and historical order attachments.
# If omitted, these files use R2_BUCKET_NAME. Keep the bucket itself private either way.
# R2_PRIVATE_BUCKET_NAME=your-private-order-files-bucket
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# IMAGE_PREFIX=staging (optional; defaults to NODE_ENV)
