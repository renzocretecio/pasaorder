NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pasaorder:pasaorder@localhost:5432/pasaorder
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
# Optional Clef-flash decision router (Cloudflare Workers AI).
# Use the API token VALUE from Workers AI > Use REST API, not its token ID.
# CLOUDFLARE_AI_ACCOUNT_ID=your-account-id
# CLOUDFLARE_AI_API_TOKEN=your-workers-ai-api-token
# Optional order extraction for reviewed chat drafts (Google Gemini API)
# GEMINI_API_KEY=your-gemini-api-key
# Optional Facebook Messenger Page connection (Meta Login for Business).
# Set the callback URL in Meta to https://your-api-domain/api/meta/oauth/callback
# and the webhook callback to https://your-api-domain/api/meta/webhook.
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
# META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-value
# (META_VERIFY_TOKEN is also accepted for older env files.)
# META_TOKEN_ENCRYPTION_KEY=64-character-hex-key (openssl rand -hex 32)
# META_REDIRECT_URI=https://your-api-domain/api/meta/oauth/callback
# META_GRAPH_API_VERSION=v26.0
# Optional Object Storage image uploads (OCI Customer Secret Key)
# OCI_NAMESPACE=your-namespace
# OCI_REGION=your-region
# OCI_BUCKET_NAME=your-bucket
# OCI_ACCESS_KEY_ID=your-access-key
# OCI_SECRET_ACCESS_KEY=your-secret-key
# OCI_IMAGE_PREFIX=staging (optional; defaults to NODE_ENV)
